# Live-Daten: werden per Cron neu erzeugt (refresh-data.mjs / refresh-videos.mjs)
data/*.json
data/*.json.bak-*
data/*.json.status.json
data/*.json.tmp-*
data/feed.ics

# Vorkomprimierte Varianten der Assets: aus den .js/.css ableitbar, nicht versionieren
www/**/*.br
www/**/*.gz

# Der Kalender-Feed wird aus den Live-Daten erzeugt (scripts/generate-ics.mjs)
# und liegt in data/ - er darf nicht als statisches File im www-Baum liegen.
www/feed.ics
www/feed.ics.br
www/feed.ics.gz

# Logs / lokale Zustände
*.log
*.status.json
.DS_Store
node_modules/

